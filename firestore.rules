rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasRole(r) {
      return signedIn() && exists(myDoc()) && get(myDoc()).data.role == r && get(myDoc()).data.status == 'approved';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole('admin') || hasRole('teacher'));
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role in ['student', 'teacher', 'parent'];
      allow update: if hasRole('admin')
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.year == resource.data.year
                        && request.resource.data.cls == resource.data.cls
                        && request.resource.data.classKey == resource.data.classKey
                        && request.resource.data.idNumber == resource.data.idNumber);
    }
    match /attendance/{id} {
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || hasRole('admin') || hasRole('teacher'));
      allow create, update: if (hasRole('teacher') || hasRole('admin'))
                            && request.resource.data.status in ['P', 'A']
                            && request.resource.data.markedBy == request.auth.uid;
    }
    function myData() { return get(myDoc()).data; }
    function canReadPost() {
      return hasRole('teacher') || hasRole('admin')
        || (hasRole('student') && resource.data.year == myData().year && resource.data.cls == myData().cls);
    }
    function canCreatePost() {
      return (hasRole('teacher') || hasRole('admin')) && request.resource.data.createdBy == request.auth.uid;
    }
    function canDeletePost() {
      return hasRole('admin') || (hasRole('teacher') && resource.data.createdBy == request.auth.uid);
    }
    match /notes/{id} {
      allow read: if canReadPost();
      allow create: if canCreatePost();
      allow delete: if canDeletePost();
    }
    match /liveClasses/{id} {
      allow read: if canReadPost();
      allow create: if canCreatePost();
      allow delete: if canDeletePost();
    }
  }
}
